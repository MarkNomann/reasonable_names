              "value": "= {{ $('Loop Over Items').item.json.id }}",
              "type": "string"
            },
            {
              "id": "9bc20224-b2b6-4f89-8103-732f651e9dbb",
              "name": "=name",
              "value": "={{ (() => {\n  const raw = $json.message?.content ?? $json.content ?? '';\n  const m = raw.match(/\"name\"\\s*:\\s*\"([^\"]+)\"/);\n  let n = m ? m[1] : '';\n  n = n.toLowerCase().replace(/\\.(jpg|jpeg|png|gif|webp)$/,'').replace(/[^a-z0-9]+/g,'_').replace(/^_|_$/g,'').slice(0,50);\n  return n ? n + '.jpg' : '';\n})() }}",
              "type": "string"
            },
            {
              "id": "a52a2dc3-40fa-4d4e-a117-a9f911680f61",
              "name": "description",
              "value": "={{ $json.message.content.match(/\"description\"\\s*:\\s*\"([^\"]+)\"/)?.[1] || '' }}",
              "type": "string"
            },
