    {
      "parameters": {
        "resource": "image",
        "modelId": {
          "__rl": true,
          "value": "llava-phi3:latest",
          "mode": "list",
          "cachedResultName": "llava-phi3:latest"
        },
        "text": "=Describe image for yourself and give appropriate name to it.Don't imagine anything yourself.\nWrite new name into {{ $json.name }} field and keep {{ $json.id }} field as it is.\nFollow the next 5 rules for image naming:\n\n1. Field \"name\" should be readable in english. \n2. All words must be separated by underscores\n3. No digits allowed at all.\n4. All names should not contain whitespaces at all.\n5. Do not mention names of any countries and cities and castles in \"name\" field if it's not written on an image.\n\nKeep in output only new name with an extension like it was before and {{ $json.id }} \n{\n  \"id\": \"{{ $json.id }}\",\n  \"name\": \"new name\", plus file extension like .jpg .jpeg .png\n}\n\n",
        "binaryPropertyName": "=data",
        "options": {
          "low_vram": true,
          "num_batch": 256
        }
      },
      "type": "@n8n/n8n-nodes-langchain.ollama",
      "typeVersion": 1,
      "position": [
        1376,
        224
      ],
      "id": "fcb04076-bb98-4c30-9d35-b261f7c1c6c9",
      "name": "Analyze image",
      "alwaysOutputData": true,
      "credentials": {
        "ollamaApi": {
          "id": "b01aHzdDX6mSkPej",
          "name": "Ollama account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "assignments": {
          "assignments": [
            {
              "id": "ee82c108-d575-45c2-94a2-669b03259f45",
              "name": "=id",
              "value": "={{ $json.content.match(/\"id\"\\s*:\\s*\"([^\"]+)\"/)?.[1] || '' }}",
              "type": "string"
            },
            {
              "id": "9bc20224-b2b6-4f89-8103-732f651e9dbb",
              "name": "=name",
              "value": "={{ (() => { let raw = $json.content.replace(/```json/gi, '').replace(/```/g, ''); let cleaned = raw.replace(/\"([^\"]*)\"\\s*\\+\\s*\"([^\"]*)\"/g, '\"$1$2\"'); let match = cleaned.match(/\"name\"\\s*:\\s*\"([^\"]+)\"/); let name = match ? match[1] : ''; return /\\.(jpg|jpeg|png|gif|webp)$/i.test(name) ? name : name + '.jpg'; })() }}",
              "type": "string"
            }
          ]
        },
        "options": {}
      },
