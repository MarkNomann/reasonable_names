    {
      "parameters": {
        "resource": "image",
        "modelId": {
          "__rl": true,
          "value": "llava-phi3:latest",
          "mode": "list",
          "cachedResultName": "llava-phi3:latest"
        },
        "text": "=Describe image for yourself and give appropriate name to it.Don't imagine anything yourself.\nWrite new name into {{ $json.name }} field and keep {{ $json.id }} field as it is.\nFollow the next 5 rules for image naming:\n\n1. Field \"name\" should be readable in english. \n2. All words must be separated by underscores\n3. No digits allowed at all.\n4. All names should not contain whitespaces at all.\n5. Do not mention names of any countries and cities and castles in \"name\" field if it's not written on an image.\n\nKeep in output only new name with an extension like it was before and {{ $json.id }} \n{\n  \"id\": \"{{ $json.id }}\",\n  \"name\": \"new name\", plus file extension like .jpg .jpeg .png\n  \"description\": your description of an image 100 words maximum. in description include objects like trees,sea,lake, buildings... which you can find on image. Don't make assumptions in which country or city a photo was taken unless you clearly can identify it. Don't give names to buildings on images.\n  \"link_to_download_image\": {{ $json.webViewLink }}\n}",
        "binaryPropertyName": "=data",
        "options": {
          "low_vram": true,
          "num_batch": 256
        }
      },
      "type": "@n8n/n8n-nodes-langchain.ollama",
      "typeVersion": 1,
      "position": [
        1600,
        224
      ],
      "id": "fcb04076-bb98-4c30-9d35-b261f7c1c6c9",
      "name": "Analyze image",
      "alwaysOutputData": true,
      "credentials": {
        "ollamaApi": {
          "id": "b01aHzdDX6mSkPej",
          "name": "Ollama account"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
